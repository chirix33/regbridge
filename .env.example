# RegBridge is offline and deterministic by default.
REG_BRIDGE_ENV=development
REG_BRIDGE_HOST=127.0.0.1
REG_BRIDGE_PORT=8000
REG_BRIDGE_DATABASE_PATH=results/regbridge.sqlite3
REG_BRIDGE_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

LLM_MODE=fixture
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Frontend development API origin. Leave empty for Vite's local proxy.
VITE_API_BASE_URL=

# RegBridge is offline and deterministic by default.
REG_BRIDGE_ENV=development
REG_BRIDGE_HOST=127.0.0.1
REG_BRIDGE_PORT=8000
REG_BRIDGE_DATABASE_PATH=results/regbridge.sqlite3
# Leave unset for local SQLite. Vercel/Neon sets DATABASE_URL; this alias is equivalent.
REG_BRIDGE_DATABASE_URL=
REG_BRIDGE_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
REG_BRIDGE_CORS_ORIGIN_REGEX=

LLM_MODE=fixture
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
PRODUCT_INVENTORY_CAPACITY=12
PRODUCT_INVENTORY_TTL_SECONDS=3600
PRODUCT_JOB_CAPACITY=24
PRODUCT_JOB_TTL_SECONDS=7200
PRODUCT_REASONING_EFFORT=medium
PRODUCT_MAX_OUTPUT_TOKENS=4000
PRODUCT_FINAL_ANSWER_TOKEN_LIMIT=800
PRODUCT_INPUT_CHARACTER_LIMIT=16000

# Reserved until a separate endpoint and structured-output capability validation is recorded.
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=
QWEN_TIMEOUT_SECONDS=60
QWEN_STRUCTURED_OUTPUT_VALIDATED=false

# Frontend development API origin. Leave empty for Vite's local proxy.
VITE_API_BASE_URL=

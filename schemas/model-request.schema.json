{
  "$defs": {
    "ApplicationType": {
      "enum": [
        "NDA",
        "ANDA",
        "IND",
        "DMF"
      ],
      "title": "ApplicationType",
      "type": "string"
    },
    "Bindingness": {
      "enum": [
        "requirement",
        "validation",
        "recommendation",
        "informative"
      ],
      "title": "Bindingness",
      "type": "string"
    },
    "DossierEvidence": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "extraction_method": {
          "$ref": "#/$defs/ExtractionMethod",
          "default": "deterministic"
        },
        "file_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^(text|hyperlink|metadata)$",
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "artifact_id",
        "kind",
        "locator",
        "text",
        "file_sha256"
      ],
      "title": "DossierEvidence",
      "type": "object"
    },
    "EnforcementMode": {
      "enum": [
        "hard",
        "advisory",
        "semantic_signal",
        "disabled"
      ],
      "title": "EnforcementMode",
      "type": "string"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/SourceScope"
        },
        "bindingness": {
          "$ref": "#/$defs/Bindingness"
        },
        "enforcement_mode": {
          "$ref": "#/$defs/EnforcementMode"
        },
        "expert_validated": {
          "default": false,
          "title": "Expert Validated",
          "type": "boolean"
        },
        "extraction_method": {
          "$ref": "#/$defs/ExtractionMethod"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "review_events": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReviewEvent"
          },
          "title": "Review Events",
          "type": "array"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "verification_basis": {
          "$ref": "#/$defs/VerificationBasis"
        }
      },
      "required": [
        "id",
        "source_id",
        "locator",
        "text",
        "bindingness",
        "applicability",
        "source_sha256",
        "extraction_method",
        "review_status",
        "verification_basis",
        "enforcement_mode"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "ExtractionMethod": {
      "enum": [
        "manual",
        "deterministic",
        "model_candidate"
      ],
      "title": "ExtractionMethod",
      "type": "string"
    },
    "JsonValue": {},
    "ReviewDecision": {
      "enum": [
        "accepted",
        "rejected"
      ],
      "title": "ReviewDecision",
      "type": "string"
    },
    "ReviewEvent": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/ReviewDecision"
        },
        "expert_validated": {
          "default": false,
          "title": "Expert Validated",
          "type": "boolean"
        },
        "external_reviewer_qualification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Reviewer Qualification"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "independent_second_author_check": {
          "default": false,
          "title": "Independent Second Author Check",
          "type": "boolean"
        },
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Reviewer Id",
          "type": "string"
        },
        "reviewer_role": {
          "minLength": 1,
          "title": "Reviewer Role",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "source_snapshot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "supporting_source_sha256s": {
          "default": [],
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Supporting Source Sha256S",
          "type": "array"
        },
        "unresolved_assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved Assumptions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "reviewer_id",
        "reviewer_role",
        "reviewed_at",
        "object_id",
        "object_version",
        "source_snapshot_id",
        "source_sha256",
        "decision",
        "rationale"
      ],
      "title": "ReviewEvent",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "candidate",
        "source_verified",
        "author_adjudicated_for_demo",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SourceScope": {
      "additionalProperties": false,
      "properties": {
        "application_types": {
          "items": {
            "$ref": "#/$defs/ApplicationType"
          },
          "minItems": 1,
          "title": "Application Types",
          "type": "array"
        },
        "source_standards": {
          "items": {
            "$ref": "#/$defs/StandardVersion"
          },
          "minItems": 1,
          "title": "Source Standards",
          "type": "array"
        },
        "target_standards": {
          "items": {
            "$ref": "#/$defs/StandardVersion"
          },
          "minItems": 1,
          "title": "Target Standards",
          "type": "array"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "required": [
        "application_types",
        "source_standards",
        "target_standards"
      ],
      "title": "SourceScope",
      "type": "object"
    },
    "StandardVersion": {
      "enum": [
        "eCTD-3.2.2",
        "eCTD-4.0"
      ],
      "title": "StandardVersion",
      "type": "string"
    },
    "VerificationBasis": {
      "enum": [
        "direct_standard_encoding",
        "mechanical_derivation",
        "author_interpretation",
        "semantic_inference",
        "synthetic_assumption"
      ],
      "title": "VerificationBasis",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "context": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Context",
      "type": "object"
    },
    "evidence": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/EvidenceSpan"
          },
          {
            "$ref": "#/$defs/DossierEvidence"
          }
        ]
      },
      "title": "Evidence",
      "type": "array"
    },
    "fixture_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Fixture Id",
      "type": "string"
    },
    "prompt_template_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Prompt Template Version",
      "type": "string"
    },
    "task": {
      "minLength": 1,
      "title": "Task",
      "type": "string"
    }
  },
  "required": [
    "fixture_id",
    "task",
    "context",
    "evidence",
    "prompt_template_version"
  ],
  "title": "ModelRequest",
  "type": "object"
}

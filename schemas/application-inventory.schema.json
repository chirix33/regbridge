{
  "$defs": {
    "LifecycleOperation": {
      "enum": [
        "new",
        "replace",
        "append",
        "delete"
      ],
      "title": "LifecycleOperation",
      "type": "string"
    },
    "ParseWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Code",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "locator"
      ],
      "title": "ParseWarning",
      "type": "object"
    },
    "ParsedHyperlink": {
      "additionalProperties": false,
      "properties": {
        "author_verified_relevant": {
          "default": false,
          "title": "Author Verified Relevant",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "target": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "target_exists": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Exists"
        },
        "target_type": {
          "enum": [
            "uri",
            "internal",
            "unsupported"
          ],
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "page",
        "target_type",
        "target",
        "locator"
      ],
      "title": "ParsedHyperlink",
      "type": "object"
    },
    "ParsedKeyword": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Name",
          "type": "string"
        },
        "normalized_value": {
          "minLength": 1,
          "title": "Normalized Value",
          "type": "string"
        },
        "raw_value": {
          "minLength": 1,
          "title": "Raw Value",
          "type": "string"
        },
        "source_locator": {
          "minLength": 1,
          "title": "Source Locator",
          "type": "string"
        }
      },
      "required": [
        "name",
        "raw_value",
        "normalized_value",
        "source_locator"
      ],
      "title": "ParsedKeyword",
      "type": "object"
    },
    "ParsedLeaf": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$",
          "title": "Content Type",
          "type": "string"
        },
        "declared_checksum": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Checksum"
        },
        "extraction_status": {
          "default": "completed",
          "enum": [
            "completed",
            "failed",
            "bounded"
          ],
          "title": "Extraction Status",
          "type": "string"
        },
        "file_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "heading": {
          "pattern": "^\\d+(?:\\.[A-Za-z0-9]+)+$",
          "title": "Heading",
          "type": "string"
        },
        "href": {
          "minLength": 1,
          "title": "Href",
          "type": "string"
        },
        "hyperlink_count": {
          "default": 0,
          "minimum": 0,
          "title": "Hyperlink Count",
          "type": "integer"
        },
        "hyperlinks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ParsedHyperlink"
          },
          "title": "Hyperlinks",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "keywords": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ParsedKeyword"
          },
          "title": "Keywords",
          "type": "array"
        },
        "modified_leaf_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modified Leaf Id"
        },
        "operation": {
          "$ref": "#/$defs/LifecycleOperation"
        },
        "source_locator": {
          "minLength": 1,
          "title": "Source Locator",
          "type": "string"
        },
        "text_span_count": {
          "default": 0,
          "minimum": 0,
          "title": "Text Span Count",
          "type": "integer"
        },
        "text_spans": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ParsedTextSpan"
          },
          "title": "Text Spans",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "heading",
        "href",
        "operation",
        "content_type",
        "file_sha256",
        "source_locator"
      ],
      "title": "ParsedLeaf",
      "type": "object"
    },
    "ParsedTextSpan": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "page",
        "text",
        "locator"
      ],
      "title": "ParsedTextSpan",
      "type": "object"
    },
    "StandardVersion": {
      "enum": [
        "eCTD-3.2.2",
        "eCTD-4.0"
      ],
      "title": "StandardVersion",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "applicant_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applicant Name"
    },
    "application_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Application Number"
    },
    "fixture_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fixture Id"
    },
    "has_stf": {
      "title": "Has Stf",
      "type": "boolean"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Id",
      "type": "string"
    },
    "leaves": {
      "items": {
        "$ref": "#/$defs/ParsedLeaf"
      },
      "minItems": 1,
      "title": "Leaves",
      "type": "array"
    },
    "package_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Package Sha256",
      "type": "string"
    },
    "source_standard": {
      "$ref": "#/$defs/StandardVersion"
    },
    "submission_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submission Type"
    },
    "warnings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ParseWarning"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "id",
    "source_standard",
    "has_stf",
    "package_sha256",
    "leaves"
  ],
  "title": "ApplicationInventory",
  "type": "object"
}

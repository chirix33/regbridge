{
  "$defs": {
    "SemanticFinding": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "observation",
            "inference"
          ],
          "title": "Basis",
          "type": "string"
        },
        "category": {
          "default": "ambiguous_reference",
          "enum": [
            "obsolete_heading",
            "applicant_name_mismatch",
            "irrelevant_hyperlink",
            "broken_internal_destination",
            "benign_historical_reference",
            "ambiguous_reference"
          ],
          "title": "Category",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "informational",
            "low",
            "medium",
            "high"
          ],
          "title": "Severity",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "basis",
        "summary",
        "severity",
        "evidence_ids"
      ],
      "title": "SemanticFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "abstain_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Abstain Reason"
    },
    "abstained": {
      "title": "Abstained",
      "type": "boolean"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/SemanticFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "fixture_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Fixture Version",
      "type": "string"
    }
  },
  "required": [
    "fixture_version",
    "abstained",
    "abstain_reason",
    "findings",
    "confidence"
  ],
  "title": "SemanticRiskOutput",
  "type": "object"
}

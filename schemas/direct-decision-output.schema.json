{
  "$defs": {
    "Decision": {
      "enum": [
        "REUSE_AS_LEGACY_REFERENCE",
        "REUSE_WITH_NEW_CONTEXT",
        "REUSE_AFTER_METADATA_REPAIR",
        "BREAK_LIFECYCLE_AND_RESUBMIT",
        "DO_NOT_REUSE",
        "HUMAN_REGULATORY_REVIEW"
      ],
      "title": "Decision",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "informational",
        "low",
        "medium",
        "high",
        "blocking",
        "unresolved"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "AUTHOR_REVIEW_HEADING_MAPPING",
        "CREATE_NEW_CONTEXT_GROUP_AND_SUSPEND_LEGACY_CONTENT",
        "CREATE_NEW_CONTEXT_GROUP_AND_SUSPEND_OLD",
        "DECLARE_MANUFACTURER_PARTITIONING",
        "DECLARE_METADATA_MIGRATION_INTENT",
        "HUMAN_VERIFY_STALE_CONTENT",
        "NO_MATERIAL_REPAIR",
        "PRESERVE_EXACT_CONTEXT_GROUP_KEYWORDS",
        "SELECT_SUPPORTED_REUSE_OPERATION",
        "VERIFY_HYPERLINK_RELEVANCE",
        "WAIT_FOR_OPERATIONAL_AVAILABILITY"
      ],
      "title": "Action",
      "type": "string"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "human_review_required": {
      "title": "Human Review Required",
      "type": "boolean"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    }
  },
  "required": [
    "decision",
    "severity",
    "action",
    "human_review_required",
    "rationale"
  ],
  "title": "DirectDecisionOutput",
  "type": "object"
}

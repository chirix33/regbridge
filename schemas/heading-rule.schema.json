{
  "$defs": {
    "ApplicationType": {
      "enum": [
        "NDA",
        "ANDA",
        "IND",
        "DMF"
      ],
      "title": "ApplicationType",
      "type": "string"
    },
    "Authority": {
      "enum": [
        "FDA"
      ],
      "title": "Authority",
      "type": "string"
    },
    "Center": {
      "enum": [
        "CDER"
      ],
      "title": "Center",
      "type": "string"
    },
    "Decision": {
      "enum": [
        "REUSE_AS_LEGACY_REFERENCE",
        "REUSE_WITH_NEW_CONTEXT",
        "REUSE_AFTER_METADATA_REPAIR",
        "BREAK_LIFECYCLE_AND_RESUBMIT",
        "DO_NOT_REUSE",
        "HUMAN_REGULATORY_REVIEW"
      ],
      "title": "Decision",
      "type": "string"
    },
    "EnforcementMode": {
      "enum": [
        "hard",
        "advisory",
        "semantic_signal",
        "disabled"
      ],
      "title": "EnforcementMode",
      "type": "string"
    },
    "ReviewDecision": {
      "enum": [
        "accepted",
        "rejected"
      ],
      "title": "ReviewDecision",
      "type": "string"
    },
    "ReviewEvent": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/ReviewDecision"
        },
        "expert_validated": {
          "default": false,
          "title": "Expert Validated",
          "type": "boolean"
        },
        "external_reviewer_qualification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Reviewer Qualification"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "independent_second_author_check": {
          "default": false,
          "title": "Independent Second Author Check",
          "type": "boolean"
        },
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Reviewer Id",
          "type": "string"
        },
        "reviewer_role": {
          "minLength": 1,
          "title": "Reviewer Role",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "source_snapshot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "supporting_source_sha256s": {
          "default": [],
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Supporting Source Sha256S",
          "type": "array"
        },
        "unresolved_assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved Assumptions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "reviewer_id",
        "reviewer_role",
        "reviewed_at",
        "object_id",
        "object_version",
        "source_snapshot_id",
        "source_sha256",
        "decision",
        "rationale"
      ],
      "title": "ReviewEvent",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "candidate",
        "source_verified",
        "author_adjudicated_for_demo",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "RuleScope": {
      "additionalProperties": false,
      "properties": {
        "application_types": {
          "items": {
            "$ref": "#/$defs/ApplicationType"
          },
          "minItems": 1,
          "title": "Application Types",
          "type": "array"
        },
        "authority": {
          "$ref": "#/$defs/Authority"
        },
        "center": {
          "$ref": "#/$defs/Center"
        },
        "source_standard": {
          "$ref": "#/$defs/StandardVersion"
        },
        "target_standard": {
          "$ref": "#/$defs/StandardVersion"
        }
      },
      "required": [
        "authority",
        "center",
        "application_types",
        "source_standard",
        "target_standard"
      ],
      "title": "RuleScope",
      "type": "object"
    },
    "ScenarioMode": {
      "enum": [
        "prospective_forward_compatibility",
        "current_operational"
      ],
      "title": "ScenarioMode",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "informational",
        "low",
        "medium",
        "high",
        "blocking",
        "unresolved"
      ],
      "title": "Severity",
      "type": "string"
    },
    "StandardVersion": {
      "enum": [
        "eCTD-3.2.2",
        "eCTD-4.0"
      ],
      "title": "StandardVersion",
      "type": "string"
    },
    "VerificationBasis": {
      "enum": [
        "direct_standard_encoding",
        "mechanical_derivation",
        "author_interpretation",
        "semantic_inference",
        "synthetic_assumption"
      ],
      "title": "VerificationBasis",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "enforcement_mode": {
      "$ref": "#/$defs/EnforcementMode"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "expert_validated": {
      "default": false,
      "title": "Expert Validated",
      "type": "boolean"
    },
    "explicit_heading_mapping": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Explicit Heading Mapping",
      "type": "object"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Id",
      "type": "string"
    },
    "repair_description": {
      "minLength": 1,
      "title": "Repair Description",
      "type": "string"
    },
    "repair_type": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Repair Type",
      "type": "string"
    },
    "review_event": {
      "$ref": "#/$defs/ReviewEvent"
    },
    "review_status": {
      "$ref": "#/$defs/ReviewStatus"
    },
    "scenario_mode": {
      "$ref": "#/$defs/ScenarioMode"
    },
    "scope": {
      "$ref": "#/$defs/RuleScope"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "verification_basis": {
      "$ref": "#/$defs/VerificationBasis"
    },
    "verified_available_target_headings": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Verified Available Target Headings",
      "type": "array"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "title",
    "description",
    "review_status",
    "verification_basis",
    "enforcement_mode",
    "scenario_mode",
    "scope",
    "explicit_heading_mapping",
    "verified_available_target_headings",
    "decision",
    "severity",
    "repair_type",
    "repair_description",
    "evidence_ids",
    "review_event"
  ],
  "title": "HeadingRule",
  "type": "object"
}

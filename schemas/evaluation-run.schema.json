{
  "$defs": {
    "CaseEvaluation": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "conservative_false_positive": {
          "title": "Conservative False Positive",
          "type": "boolean"
        },
        "correct": {
          "title": "Correct",
          "type": "boolean"
        },
        "fixture_family": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Fixture Family",
          "type": "string"
        },
        "prediction_action": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Prediction Action",
          "type": "string"
        },
        "prediction_decision": {
          "$ref": "#/$defs/Decision"
        },
        "reference_action": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Reference Action",
          "type": "string"
        },
        "reference_decision": {
          "$ref": "#/$defs/Decision"
        },
        "review_bypass": {
          "title": "Review Bypass",
          "type": "boolean"
        },
        "split": {
          "title": "Split",
          "type": "string"
        },
        "system": {
          "enum": [
            "B0",
            "B1",
            "B2",
            "RegBridge"
          ],
          "title": "System",
          "type": "string"
        },
        "unsafe_false_negative": {
          "title": "Unsafe False Negative",
          "type": "boolean"
        }
      },
      "required": [
        "case_id",
        "fixture_family",
        "split",
        "system",
        "reference_decision",
        "prediction_decision",
        "reference_action",
        "prediction_action",
        "unsafe_false_negative",
        "review_bypass",
        "conservative_false_positive",
        "correct"
      ],
      "title": "CaseEvaluation",
      "type": "object"
    },
    "ClassMetrics": {
      "additionalProperties": false,
      "properties": {
        "f1": {
          "title": "F1",
          "type": "number"
        },
        "precision": {
          "title": "Precision",
          "type": "number"
        },
        "recall": {
          "title": "Recall",
          "type": "number"
        },
        "support": {
          "title": "Support",
          "type": "integer"
        }
      },
      "required": [
        "precision",
        "recall",
        "f1",
        "support"
      ],
      "title": "ClassMetrics",
      "type": "object"
    },
    "Decision": {
      "enum": [
        "REUSE_AS_LEGACY_REFERENCE",
        "REUSE_WITH_NEW_CONTEXT",
        "REUSE_AFTER_METADATA_REPAIR",
        "BREAK_LIFECYCLE_AND_RESUBMIT",
        "DO_NOT_REUSE",
        "HUMAN_REGULATORY_REVIEW"
      ],
      "title": "Decision",
      "type": "string"
    },
    "EvaluationArtifacts": {
      "additionalProperties": false,
      "properties": {
        "manifest_json": {
          "title": "Manifest Json",
          "type": "string"
        },
        "metrics_content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Metrics Content Sha256",
          "type": "string"
        },
        "metrics_csv": {
          "title": "Metrics Csv",
          "type": "string"
        },
        "metrics_json": {
          "title": "Metrics Json",
          "type": "string"
        },
        "paper_deterministic_table_csv": {
          "title": "Paper Deterministic Table Csv",
          "type": "string"
        },
        "paper_retrieval_table_csv": {
          "title": "Paper Retrieval Table Csv",
          "type": "string"
        },
        "paper_table_csv": {
          "title": "Paper Table Csv",
          "type": "string"
        },
        "per_case_csv": {
          "title": "Per Case Csv",
          "type": "string"
        },
        "prediction_content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Prediction Content Sha256",
          "type": "string"
        },
        "predictions_jsonl": {
          "title": "Predictions Jsonl",
          "type": "string"
        },
        "retrieval_jsonl": {
          "title": "Retrieval Jsonl",
          "type": "string"
        },
        "run_directory": {
          "title": "Run Directory",
          "type": "string"
        },
        "summary_markdown": {
          "title": "Summary Markdown",
          "type": "string"
        }
      },
      "required": [
        "run_directory",
        "manifest_json",
        "predictions_jsonl",
        "retrieval_jsonl",
        "per_case_csv",
        "metrics_json",
        "metrics_csv",
        "summary_markdown",
        "paper_table_csv",
        "paper_deterministic_table_csv",
        "paper_retrieval_table_csv",
        "prediction_content_sha256",
        "metrics_content_sha256"
      ],
      "title": "EvaluationArtifacts",
      "type": "object"
    },
    "FamilySensitivity": {
      "additionalProperties": false,
      "properties": {
        "eligible_cases": {
          "title": "Eligible Cases",
          "type": "integer"
        },
        "fixture_family": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Fixture Family",
          "type": "string"
        },
        "unsafe_misses": {
          "title": "Unsafe Misses",
          "type": "integer"
        }
      },
      "required": [
        "fixture_family",
        "unsafe_misses",
        "eligible_cases"
      ],
      "title": "FamilySensitivity",
      "type": "object"
    },
    "MetricsReport": {
      "additionalProperties": false,
      "properties": {
        "abstention_accuracy": {
          "title": "Abstention Accuracy",
          "type": "number"
        },
        "accuracy": {
          "title": "Accuracy",
          "type": "number"
        },
        "action_required_family_count": {
          "title": "Action Required Family Count",
          "type": "integer"
        },
        "balanced_accuracy": {
          "title": "Balanced Accuracy",
          "type": "number"
        },
        "calibration_not_applicable_reason": {
          "title": "Calibration Not Applicable Reason",
          "type": "string"
        },
        "calibration_status": {
          "const": "not_applicable",
          "title": "Calibration Status",
          "type": "string"
        },
        "cluster_bootstrap_unsafe_fnr_95": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cluster Bootstrap Unsafe Fnr 95"
        },
        "conservative_false_positive_rate": {
          "$ref": "#/$defs/RateMetric"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost Usd"
        },
        "evidence_citation_accuracy": {
          "title": "Evidence Citation Accuracy",
          "type": "number"
        },
        "failures": {
          "title": "Failures",
          "type": "integer"
        },
        "families_with_unsafe_misses": {
          "title": "Families With Unsafe Misses",
          "type": "integer"
        },
        "family_sensitivity": {
          "items": {
            "$ref": "#/$defs/FamilySensitivity"
          },
          "title": "Family Sensitivity",
          "type": "array"
        },
        "heading_mapping_accuracy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Heading Mapping Accuracy"
        },
        "high_blocking_unsafe_false_negative_rate": {
          "$ref": "#/$defs/RateMetric"
        },
        "inference_claims": {
          "const": "exploratory-only-no-independence-or-significance-claims",
          "title": "Inference Claims",
          "type": "string"
        },
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "interval_interpretation": {
          "enum": [
            "scorer validation only; no statistical interpretation",
            "exploratory only; no independence or significance claim"
          ],
          "title": "Interval Interpretation",
          "type": "string"
        },
        "latency_ms_total": {
          "title": "Latency Ms Total",
          "type": "number"
        },
        "macro_f1": {
          "title": "Macro F1",
          "type": "number"
        },
        "output_tokens": {
          "title": "Output Tokens",
          "type": "integer"
        },
        "per_class": {
          "additionalProperties": {
            "$ref": "#/$defs/ClassMetrics"
          },
          "title": "Per Class",
          "type": "object"
        },
        "repair_action_accuracy": {
          "title": "Repair Action Accuracy",
          "type": "number"
        },
        "represented_classes": {
          "items": {
            "$ref": "#/$defs/Decision"
          },
          "title": "Represented Classes",
          "type": "array"
        },
        "requests": {
          "title": "Requests",
          "type": "integer"
        },
        "result_status": {
          "enum": [
            "fixture validation only",
            "genuine deterministic experimental output",
            "live model output"
          ],
          "title": "Result Status",
          "type": "string"
        },
        "retrieval": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrievalMetrics"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_bypass_rate": {
          "$ref": "#/$defs/RateMetric"
        },
        "scope": {
          "enum": [
            "held-out-test",
            "all-cases-secondary",
            "phase1-train",
            "phase1-development",
            "phase1-train-development"
          ],
          "title": "Scope",
          "type": "string"
        },
        "system": {
          "enum": [
            "B0",
            "B1",
            "B2",
            "RegBridge"
          ],
          "title": "System",
          "type": "string"
        },
        "unsafe_false_negative_rate": {
          "$ref": "#/$defs/RateMetric"
        }
      },
      "required": [
        "system",
        "result_status",
        "interval_interpretation",
        "scope",
        "represented_classes",
        "unsafe_false_negative_rate",
        "high_blocking_unsafe_false_negative_rate",
        "review_bypass_rate",
        "conservative_false_positive_rate",
        "per_class",
        "macro_f1",
        "accuracy",
        "balanced_accuracy",
        "heading_mapping_accuracy",
        "evidence_citation_accuracy",
        "repair_action_accuracy",
        "abstention_accuracy",
        "retrieval",
        "latency_ms_total",
        "failures",
        "requests",
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "calibration_status",
        "calibration_not_applicable_reason",
        "family_sensitivity",
        "action_required_family_count",
        "families_with_unsafe_misses",
        "cluster_bootstrap_unsafe_fnr_95",
        "inference_claims"
      ],
      "title": "MetricsReport",
      "type": "object"
    },
    "RateMetric": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "title": "Numerator",
          "type": "integer"
        },
        "rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rate"
        },
        "wilson_95_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Wilson 95 High"
        },
        "wilson_95_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Wilson 95 Low"
        }
      },
      "required": [
        "numerator",
        "denominator",
        "rate",
        "wilson_95_low",
        "wilson_95_high"
      ],
      "title": "RateMetric",
      "type": "object"
    },
    "RetrievalMetrics": {
      "additionalProperties": false,
      "properties": {
        "evaluated_cases": {
          "title": "Evaluated Cases",
          "type": "integer"
        },
        "mrr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mrr"
        },
        "precision_at_3": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Precision At 3"
        },
        "recall_at_3": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recall At 3"
        },
        "result_status": {
          "const": "genuine deterministic retrieval measurement",
          "default": "genuine deterministic retrieval measurement",
          "title": "Result Status",
          "type": "string"
        }
      },
      "required": [
        "evaluated_cases",
        "recall_at_3",
        "precision_at_3",
        "mrr"
      ],
      "title": "RetrievalMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvaluationArtifacts"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cases": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CaseEvaluation"
      },
      "title": "Cases",
      "type": "array"
    },
    "configuration_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Configuration Id",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "current_fda_operational_availability": {
      "const": "not_operational",
      "title": "Current Fda Operational Availability",
      "type": "string"
    },
    "eligible_for_performance_claims": {
      "const": false,
      "title": "Eligible For Performance Claims",
      "type": "boolean"
    },
    "empirical_model_run": {
      "const": false,
      "title": "Empirical Model Run",
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Id",
      "type": "string"
    },
    "metrics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MetricsReport"
      },
      "title": "Metrics",
      "type": "array"
    },
    "run_type": {
      "const": "deterministic_fixture_validation",
      "title": "Run Type",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed"
      ],
      "title": "State",
      "type": "string"
    },
    "systems": {
      "items": {
        "enum": [
          "B0",
          "B1",
          "B2",
          "RegBridge"
        ],
        "type": "string"
      },
      "title": "Systems",
      "type": "array"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "configuration_id",
    "state",
    "run_type",
    "empirical_model_run",
    "eligible_for_performance_claims",
    "current_fda_operational_availability",
    "systems",
    "seed",
    "created_at",
    "updated_at"
  ],
  "title": "EvaluationRun",
  "type": "object"
}

{
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "additionalProperties": false,
        "properties": {
          "inventory_id": {
            "title": "Inventory Id",
            "type": "string"
          },
          "leaf_id": {
            "title": "Leaf Id",
            "type": "string"
          },
          "target_context": {
            "$ref": "#/components/schemas/TargetContext"
          }
        },
        "required": [
          "inventory_id",
          "leaf_id",
          "target_context"
        ],
        "title": "AnalysisRequest",
        "type": "object"
      },
      "AnalysisResponse": {
        "additionalProperties": false,
        "properties": {
          "analysis": {
            "$ref": "#/components/schemas/AnalysisResult"
          }
        },
        "required": [
          "analysis"
        ],
        "title": "AnalysisResponse",
        "type": "object"
      },
      "AnalysisResult": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceSpan"
            },
            "title": "Evidence",
            "type": "array"
          },
          "expert_validated": {
            "default": false,
            "title": "Expert Validated",
            "type": "boolean"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "title": "Findings",
            "type": "array"
          },
          "human_approval_required": {
            "title": "Human Approval Required",
            "type": "boolean"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Id",
            "type": "string"
          },
          "operational_status": {
            "$ref": "#/components/schemas/OperationalStatus"
          },
          "rationale": {
            "minLength": 1,
            "title": "Rationale",
            "type": "string"
          },
          "repair": {
            "$ref": "#/components/schemas/RepairAction"
          },
          "scenario_disclosure": {
            "minLength": 1,
            "title": "Scenario Disclosure",
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "source_artifact": {
            "$ref": "#/components/schemas/SourceArtifact"
          },
          "target_context": {
            "$ref": "#/components/schemas/TargetContext"
          },
          "trace": {
            "items": {
              "$ref": "#/components/schemas/TraceStep"
            },
            "minItems": 1,
            "title": "Trace",
            "type": "array"
          },
          "triggered_rule_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            "title": "Triggered Rule Ids",
            "type": "array"
          },
          "unresolved_uncertainty": {
            "items": {
              "type": "string"
            },
            "title": "Unresolved Uncertainty",
            "type": "array"
          }
        },
        "required": [
          "id",
          "source_artifact",
          "target_context",
          "operational_status",
          "scenario_disclosure",
          "decision",
          "severity",
          "triggered_rule_ids",
          "findings",
          "evidence",
          "rationale",
          "repair",
          "confidence",
          "unresolved_uncertainty",
          "human_approval_required",
          "trace"
        ],
        "title": "AnalysisResult",
        "type": "object"
      },
      "ApplicationInventory": {
        "additionalProperties": false,
        "properties": {
          "applicant_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Applicant Name"
          },
          "application_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Application Number"
          },
          "fixture_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fixture Id"
          },
          "has_stf": {
            "title": "Has Stf",
            "type": "boolean"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Id",
            "type": "string"
          },
          "leaves": {
            "items": {
              "$ref": "#/components/schemas/ParsedLeaf"
            },
            "minItems": 1,
            "title": "Leaves",
            "type": "array"
          },
          "package_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Package Sha256",
            "type": "string"
          },
          "source_standard": {
            "$ref": "#/components/schemas/StandardVersion"
          },
          "submission_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Submission Type"
          },
          "warnings": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ParseWarning"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "id",
          "source_standard",
          "has_stf",
          "package_sha256",
          "leaves"
        ],
        "title": "ApplicationInventory",
        "type": "object"
      },
      "ApplicationType": {
        "enum": [
          "NDA",
          "ANDA",
          "IND",
          "DMF"
        ],
        "title": "ApplicationType",
        "type": "string"
      },
      "Authority": {
        "enum": [
          "FDA"
        ],
        "title": "Authority",
        "type": "string"
      },
      "Bindingness": {
        "enum": [
          "requirement",
          "validation",
          "recommendation",
          "informative"
        ],
        "title": "Bindingness",
        "type": "string"
      },
      "Center": {
        "enum": [
          "CDER"
        ],
        "title": "Center",
        "type": "string"
      },
      "Decision": {
        "enum": [
          "REUSE_AS_LEGACY_REFERENCE",
          "REUSE_WITH_NEW_CONTEXT",
          "REUSE_AFTER_METADATA_REPAIR",
          "BREAK_LIFECYCLE_AND_RESUBMIT",
          "DO_NOT_REUSE",
          "HUMAN_REGULATORY_REVIEW"
        ],
        "title": "Decision",
        "type": "string"
      },
      "EdgeType": {
        "enum": [
          "LOCATED_UNDER",
          "AVAILABLE_IN",
          "REMOVED_IN",
          "MAPS_TO",
          "SUPPORTED_BY",
          "REQUIRES_REPAIR",
          "TRIGGERS_DECISION"
        ],
        "title": "EdgeType",
        "type": "string"
      },
      "EnforcementMode": {
        "enum": [
          "hard",
          "advisory",
          "semantic_signal",
          "disabled"
        ],
        "title": "EnforcementMode",
        "type": "string"
      },
      "EvidenceSpan": {
        "additionalProperties": false,
        "properties": {
          "applicability": {
            "$ref": "#/components/schemas/SourceScope"
          },
          "bindingness": {
            "$ref": "#/components/schemas/Bindingness"
          },
          "enforcement_mode": {
            "$ref": "#/components/schemas/EnforcementMode"
          },
          "expert_validated": {
            "default": false,
            "title": "Expert Validated",
            "type": "boolean"
          },
          "extraction_method": {
            "$ref": "#/components/schemas/ExtractionMethod"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Id",
            "type": "string"
          },
          "locator": {
            "minLength": 1,
            "title": "Locator",
            "type": "string"
          },
          "review_events": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ReviewEvent"
            },
            "title": "Review Events",
            "type": "array"
          },
          "review_status": {
            "$ref": "#/components/schemas/ReviewStatus"
          },
          "source_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Source Id",
            "type": "string"
          },
          "source_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Source Sha256",
            "type": "string"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "verification_basis": {
            "$ref": "#/components/schemas/VerificationBasis"
          }
        },
        "required": [
          "id",
          "source_id",
          "locator",
          "text",
          "bindingness",
          "applicability",
          "source_sha256",
          "extraction_method",
          "review_status",
          "verification_basis",
          "enforcement_mode"
        ],
        "title": "EvidenceSpan",
        "type": "object"
      },
      "ExtractionMethod": {
        "enum": [
          "manual",
          "deterministic",
          "model_candidate"
        ],
        "title": "ExtractionMethod",
        "type": "string"
      },
      "Finding": {
        "additionalProperties": false,
        "properties": {
          "evidence_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            "minItems": 1,
            "title": "Evidence Ids",
            "type": "array"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Id",
            "type": "string"
          },
          "rationale": {
            "minLength": 1,
            "title": "Rationale",
            "type": "string"
          },
          "rule_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rule Id"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "source": {
            "$ref": "#/components/schemas/TraceStepKind"
          }
        },
        "required": [
          "id",
          "severity",
          "rationale",
          "evidence_ids",
          "source"
        ],
        "title": "Finding",
        "type": "object"
      },
      "FixtureListResponse": {
        "additionalProperties": false,
        "properties": {
          "fixtures": {
            "items": {
              "$ref": "#/components/schemas/FixtureSummary"
            },
            "title": "Fixtures",
            "type": "array"
          }
        },
        "required": [
          "fixtures"
        ],
        "title": "FixtureListResponse",
        "type": "object"
      },
      "FixtureSummary": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "expected_class": {
            "pattern": "^(positive|negative|ambiguous)$",
            "title": "Expected Class",
            "type": "string"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "expected_class"
        ],
        "title": "FixtureSummary",
        "type": "object"
      },
      "GraphEdge": {
        "additionalProperties": false,
        "properties": {
          "enforcement_mode": {
            "$ref": "#/components/schemas/EnforcementMode",
            "default": "disabled"
          },
          "evidence_ids": {
            "default": [],
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "expert_validated": {
            "default": false,
            "title": "Expert Validated",
            "type": "boolean"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "review_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReviewStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Source",
            "type": "string"
          },
          "target": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Target",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/EdgeType"
          },
          "verification_basis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VerificationBasis"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "source",
          "target",
          "type",
          "label"
        ],
        "title": "GraphEdge",
        "type": "object"
      },
      "GraphNeighborhood": {
        "additionalProperties": false,
        "properties": {
          "analysis_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Analysis Id",
            "type": "string"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/GraphEdge"
            },
            "title": "Edges",
            "type": "array"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/GraphNode"
            },
            "minItems": 1,
            "title": "Nodes",
            "type": "array"
          },
          "text_alternative": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Text Alternative",
            "type": "array"
          }
        },
        "required": [
          "analysis_id",
          "nodes",
          "edges",
          "text_alternative"
        ],
        "title": "GraphNeighborhood",
        "type": "object"
      },
      "GraphNode": {
        "additionalProperties": false,
        "properties": {
          "expert_validated": {
            "default": false,
            "title": "Expert Validated",
            "type": "boolean"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "properties": {
            "additionalProperties": true,
            "title": "Properties",
            "type": "object"
          },
          "review_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReviewStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "$ref": "#/components/schemas/NodeType"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "id",
          "type",
          "label"
        ],
        "title": "GraphNode",
        "type": "object"
      },
      "GraphResponse": {
        "additionalProperties": false,
        "properties": {
          "graph": {
            "$ref": "#/components/schemas/GraphNeighborhood"
          }
        },
        "required": [
          "graph"
        ],
        "title": "GraphResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "model_mode": {
            "$ref": "#/components/schemas/LlmMode"
          },
          "service": {
            "const": "regbridge",
            "title": "Service",
            "type": "string"
          },
          "standards_snapshot_id": {
            "title": "Standards Snapshot Id",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "model_mode",
          "standards_snapshot_id"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LifecycleOperation": {
        "enum": [
          "new",
          "replace",
          "append",
          "delete"
        ],
        "title": "LifecycleOperation",
        "type": "string"
      },
      "LlmMode": {
        "enum": [
          "fixture",
          "live",
          "disabled"
        ],
        "title": "LlmMode",
        "type": "string"
      },
      "NodeType": {
        "enum": [
          "artifact",
          "standard",
          "standard_version",
          "heading",
          "evidence",
          "rule",
          "repair",
          "decision"
        ],
        "title": "NodeType",
        "type": "string"
      },
      "OperationalStatus": {
        "enum": [
          "not_operational"
        ],
        "title": "OperationalStatus",
        "type": "string"
      },
      "ParseWarning": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Code",
            "type": "string"
          },
          "locator": {
            "minLength": 1,
            "title": "Locator",
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "locator"
        ],
        "title": "ParseWarning",
        "type": "object"
      },
      "ParsedLeaf": {
        "additionalProperties": false,
        "properties": {
          "content_type": {
            "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$",
            "title": "Content Type",
            "type": "string"
          },
          "declared_checksum": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Declared Checksum"
          },
          "file_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "File Sha256",
            "type": "string"
          },
          "heading": {
            "pattern": "^\\d+(?:\\.[A-Za-z0-9]+)+$",
            "title": "Heading",
            "type": "string"
          },
          "href": {
            "minLength": 1,
            "title": "Href",
            "type": "string"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Id",
            "type": "string"
          },
          "modified_leaf_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Modified Leaf Id"
          },
          "operation": {
            "$ref": "#/components/schemas/LifecycleOperation"
          },
          "source_locator": {
            "minLength": 1,
            "title": "Source Locator",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "heading",
          "href",
          "operation",
          "content_type",
          "file_sha256",
          "source_locator"
        ],
        "title": "ParsedLeaf",
        "type": "object"
      },
      "RepairAction": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "evidence_ids": {
            "default": [],
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "type": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "description"
        ],
        "title": "RepairAction",
        "type": "object"
      },
      "ReuseOperation": {
        "enum": [
          "reference-existing-content",
          "create-new-target-artifact"
        ],
        "title": "ReuseOperation",
        "type": "string"
      },
      "ReviewDecision": {
        "enum": [
          "accepted",
          "rejected"
        ],
        "title": "ReviewDecision",
        "type": "string"
      },
      "ReviewEvent": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/ReviewDecision"
          },
          "expert_validated": {
            "default": false,
            "title": "Expert Validated",
            "type": "boolean"
          },
          "external_reviewer_qualification": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Reviewer Qualification"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Id",
            "type": "string"
          },
          "independent_second_author_check": {
            "default": false,
            "title": "Independent Second Author Check",
            "type": "boolean"
          },
          "object_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Object Id",
            "type": "string"
          },
          "object_version": {
            "minLength": 1,
            "title": "Object Version",
            "type": "string"
          },
          "rationale": {
            "minLength": 1,
            "title": "Rationale",
            "type": "string"
          },
          "reviewed_at": {
            "format": "date-time",
            "title": "Reviewed At",
            "type": "string"
          },
          "reviewer_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Reviewer Id",
            "type": "string"
          },
          "reviewer_role": {
            "minLength": 1,
            "title": "Reviewer Role",
            "type": "string"
          },
          "source_sha256": {
